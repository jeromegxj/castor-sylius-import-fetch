{
    "name": "jeromegxj/castor-sylius-import-fetch",
    "description": "Castor plugin: fetch existing shop data from sitemap into YAML and push import var over SSH",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SyliusStarter\\ImportFetch\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SyliusStarter\\ImportFetch\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jérôme Gangneux",
            "email": "jerome@gangneux.net"
        }
    ],
    "require": {
        "php": ">=8.3",
        "sylius-starter/core": "^0.1@dev",
        "sylius-starter/import": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.4",
        "jolicode/castor": "^1.6",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sylius-starter/sylius-starter-core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/sylius-starter/sylius-starter-import"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "ci": [
            "@test",
            "@phpstan",
            "@cs"
        ]
    }
}
